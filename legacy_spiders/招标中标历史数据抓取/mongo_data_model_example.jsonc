// 说明：这是 JSONC（带注释的 JSON）示例，用于展示数据结构与字段含义。
// 如需作为严格 JSON 使用，请删除所有以 // 或 /* */ 开头的注释。
{
  // 一、公司画像（company_profiles）集合示例文档
  "company_profiles": [
    {
      "_id": "ObjectId('66b9c1f2a1b2c3d4e5f60101')", // MongoDB 的 ObjectId（示例）
      "owner_user_id": "user_001", // 可选：区分多用户/多公司场景
      "name": "杭州某某实业有限公司", // 公司名称（必填）
      "aliases": ["某某实业", "某某工贸"], // 别名，便于匹配
      "industry": "杯具/餐厨", // 所属行业
      "qualifications": [ // 资质列表（嵌入式）
        {
          "type": "ISO9001", // 资质类型，如 ISO9001、3C、供应商名录等
          "level": "质量管理体系",
          "certificate_no": "ISO-2024-001",
          "issued_by": "CNAS认可机构",
          "valid_from": "2024-01-01T00:00:00Z",
          "valid_to": "2027-01-01T00:00:00Z",
          "attachments": ["file:///certs/iso9001.jpg"], // 附件地址（文件或URL）
          "status": "有效" // 有效/过期/审核中
        },
        {
          "type": "供应商名录",
          "level": "国家电网合格供应商",
          "certificate_no": "",
          "issued_by": "国家电网",
          "valid_from": "2023-06-01T00:00:00Z",
          "valid_to": "2025-06-01T00:00:00Z",
          "attachments": [],
          "status": "有效"
        }
      ],
      "capabilities": { // 公司层面的能力标签（非具体单品）
        "categories": ["办公杯具", "会议杯", "礼品定制"], // 能覆盖的品类标签
        "processes": ["丝印", "移印", "钢印", "喷涂", "开模"], // 工艺能力
        "materials": ["高硼硅玻璃", "304不锈钢", "PP"], // 材料能力
        "standards": ["GB/T 29606", "LFGB"], // 执行标准/体系
        "capacity_monthly": 200000, // 月产能（估算）
        "lead_time_days": 15, // 常规交期（天）
        "moq": 500 // 最小起订量
      },
      "contact": { // 联系方式（可选）
        "address": "浙江省杭州市某区某路88号",
        "contact_name": "张三",
        "phone": "13800000000",
        "email": "sales@example.com",
        "website": "https://example.com"
      },
      "created_at": "2025-08-12T00:00:00Z",
      "updated_at": "2025-08-12T00:00:00Z"
    }
  ],

  // 二、产品目录（product_catalog）集合示例文档（与 company_profiles 形成 1:N 关系）
  "product_catalog": [
    {
      "_id": "ObjectId('66b9c1f2a1b2c3d4e5f60201')",
      "company_id": "ObjectId('66b9c1f2a1b2c3d4e5f60101')", // 引用 company_profiles._id（外键）
      "name": "高端办公会议杯-高硼硅",
      "category_path": ["杯具", "会议杯", "高端材质"], // 类目分层，用数组自顶向下表示
      "keywords": ["高硼硅", "双层玻璃", "定制LOGO"], // 关键词，便于全文检索与匹配
      "specs": [ // 规格采用键值对数组，适配不同品类的灵活字段
        { "key": "材质", "value": "高硼硅玻璃", "unit": "" },
        { "key": "容量", "value": 450, "unit": "ml" },
        { "key": "工艺", "value": "丝印/钢印", "unit": "" },
        { "key": "单价范围", "value": "160-230", "unit": "CNY" }
      ],
      "variants": [ // 可选：变体（颜色/容量/包装等）
        { "sku": "MT-450-CLR", "attrs": { "颜色": "透明", "容量": "450ml" } },
        { "sku": "MT-380-BLK", "attrs": { "颜色": "黑色", "容量": "380ml" } }
      ],
      "pricing": {
        "target_price_range": [160, 230], // 目标成交价区间（用于机会匹配）
        "currency": "CNY",
        "moq": 500
      },
      "compliance": ["LFGB", "REACH"],
      "media": ["https://cdn.example.com/products/meeting-cup-1.jpg"],
      "status": "active",
      "created_at": "2025-08-12T00:00:00Z",
      "updated_at": "2025-08-12T00:00:00Z"
    },
    {
      "_id": "ObjectId('66b9c1f2a1b2c3d4e5f60202')",
      "company_id": "ObjectId('66b9c1f2a1b2c3d4e5f60101')",
      "name": "饭盒-高硼硅玻璃四面扣",
      "category_path": ["餐厨", "饭盒", "玻璃"],
      "keywords": ["高硼硅", "四面扣", "防漏"],
      "specs": [
        { "key": "材质", "value": "高硼硅+PP+不锈钢", "unit": "" },
        { "key": "设计", "value": "四面扣盖", "unit": "" },
        { "key": "容量", "value": 1100, "unit": "ml" },
        { "key": "单价范围", "value": "16-25", "unit": "CNY" }
      ],
      "variants": [
        { "sku": "FH-1100-TRS", "attrs": { "容量": "1100ml", "分隔": "无" } }
      ],
      "pricing": { "target_price_range": [16, 25], "currency": "CNY", "moq": 3000 },
      "compliance": ["GB 4806"],
      "media": ["https://cdn.example.com/products/lunchbox-1.jpg"],
      "status": "active",
      "created_at": "2025-08-12T00:00:00Z",
      "updated_at": "2025-08-12T00:00:00Z"
    }
  ],

  // 三、可选：标准类目（product_categories）——用于统一类目与属性字典
  "product_categories": [
    {
      "_id": "ObjectId('66b9c1f2a1b2c3d4e5f60301')",
      "name": "杯具",
      "parent_id": null,
      "path": ["杯具"],
      "attributes_schema": [ // 建议该类目下常见规格键
        { "key": "材质", "type": "string", "unit": "" },
        { "key": "容量", "type": "number", "unit": "ml" },
        { "key": "工艺", "type": "string", "unit": "" },
        { "key": "单价范围", "type": "string", "unit": "CNY" }
      ]
    },
    {
      "_id": "ObjectId('66b9c1f2a1b2c3d4e5f60302')",
      "name": "会议杯",
      "parent_id": "ObjectId('66b9c1f2a1b2c3d4e5f60301')",
      "path": ["杯具", "会议杯"],
      "attributes_schema": [
        { "key": "材质", "type": "string", "unit": "" },
        { "key": "容量", "type": "number", "unit": "ml" },
        { "key": "工艺", "type": "string", "unit": "" }
      ]
    }
  ]
}