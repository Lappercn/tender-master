# ==========================================
# 1. MongoDB 数据库配置
# ==========================================
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASS=

# 旧版独立爬虫 (wj_spiders/wj_*.py) 默认写入的数据库与集合
DB_NAME=yuedongData
COLLECTION_NAME=tender_data
LOG_COLLECTION_NAME=tender_datalog

# 新版「六张网」DDD 架构按域分库名称
COLLECT_DB=six_collect
PROCESS_DB=six_process
SERVE_DB=six_serve

# ==========================================
# 2. 采集与反爬/浏览器配置
# ==========================================
CRAWL_LOOKBACK_DAYS=14
CRAWL_MAX_PAGES=40
CRAWL_HEADLESS=1
CRAWL_BROWSER=undetected
CRAWL_FINGERPRINT=fixed
CRAWL_WINDOW=1920,1080
CRAWL_LANG=zh-CN,zh
CRAWL_TIMEZONE=Asia/Shanghai

# ==========================================
# 3. 第三方验证码识别与平台账号 (按需配置，请勿提交真实密钥)
# ==========================================
YESCAPTCHA_CLIENT_KEY=your_yescaptcha_client_key_here
YESCAPTCHA_API_URL=https://api.yescaptcha.com

# 金采网 (wj_cfcpn_china.py) 供应商登录凭证
CFCPN_USERNAME=your_cfcpn_username
CFCPN_PASSWORD=your_cfcpn_password

# 千里马系列历史脚本 (legacy_spiders/) 登录凭证
QIANLIMA_USERNAME=your_qianlima_username
QIANLIMA_PASSWORD=your_qianlima_password

# ==========================================
# 4. 节点与服务端口配置
# ==========================================
NODE_ID=local-1
API_HOST=127.0.0.1
API_PORT=8787
CONSOLE_PORT=8788
